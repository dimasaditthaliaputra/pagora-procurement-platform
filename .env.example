APP_NAME="PAGORA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production: APP_ENV=production, APP_DEBUG=false, LOG_STACK=daily, LOG_LEVEL=warning
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Log queries slower than this many ms (0 = off)
DB_SLOW_QUERY_MS=1000

DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.ddahxwbmwlqnnomhfrzd
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="dimasadit836@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Upload storage: "local" (dev) or "r2" (production / Heroku, ephemeral filesystem)
UPLOAD_STORAGE=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PRIVATE_BUCKET=pagora-private
R2_PUBLIC_BUCKET=pagora-public
# Optional. Empty = serve public uploads through the app (APP_URL/files); needed where r2.dev is blocked.
# Set to a custom domain of the public bucket (no trailing slash) to bypass the app.
R2_PUBLIC_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=isi_client_id_dari_google_console
GOOGLE_CLIENT_SECRET=isi_client_secret_dari_google_console
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback